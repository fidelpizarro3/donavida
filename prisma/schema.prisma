// Este archivo define: con qué base de datos hablamos (datasource),
// y qué cliente de JS generar para usarla desde el código (generator).
// Los modelos (las 20 tablas) los vamos a ir agregando acá abajo, de a módulos.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

///////////// apartado para poner los enums /////////////////////
enum Rol {
  DONANTE
  INSTITUCION
  ADMIN
}


enum Sexo {
  MASCULINO
  FEMENINO
}

enum GrupoSanguineo {
  A 
  B 
  AB 
  O
}

enum EstadoInstitucion {
  PENDIENTE
  APROBADA
  RECHAZADA
  DADA_DE_BAJA
}

enum FactorRh {
  POSITIVO
  NEGATIVO
}

enum TipoInstitucion {
  HOSPITAL
  BANCO_SANGRE
}

enum Componente {
  SANGRE_ENTERA
  GLOBULOS_ROJOS
  PLAQUETAS
}

///////////// apartado para poner los enums /////////////////////

model usuario {
  id_usuario String @id @default(uuid())
  email String @unique
  password_hash String
  nombre String
  apellido String
  rol Rol
  email_verificado Boolean
  activo Boolean
  creado_en DateTime @default(now())
  donante  donante?
  instituciones_aprobadas   institucion[]
  usuario_institucion   usuario_institucion[]

}

model donante {
  id_donante              String    @id @default(uuid())
  id_usuario              String    @unique
  usuario                 usuario   @relation(fields: [id_usuario], references: [id_usuario])
  documento                String    @unique
  fecha_nacimiento         DateTime
  sexo                     Sexo
  grupo_sanguineo          GrupoSanguineo
  factor_rh                FactorRh
  latitud                  Decimal
  longitud                 Decimal
  contacto_hora_desde      DateTime  @db.Time()
  contacto_hora_hasta      DateTime  @db.Time()
  aviso_push               Boolean
  aviso_email              Boolean
  aviso_whatsapp           Boolean
  tope_alertas_mes         Int
  alertas_pausadas_hasta   DateTime?
  apto_desde               DateTime?
  alertas_mes_actual       Int       @default(0)
}

model institucion {
  id_institucion            String            @id @default(uuid())
  nombre                    String
  direccion                 String
  documentacion_url         String
  tipo                      TipoInstitucion
  estado                    EstadoInstitucion
  motivo_rechazo            String?
  id_usuario_aprobador      String?
  usuario_aprobador         usuario?          @relation(fields: [id_usuario_aprobador], references: [id_usuario])
  latitud                   Decimal
  longitud                  Decimal
  intervalo_donacion_dias   Int
  usuario_institucion   usuario_institucion[]
  stock_minimo   stock_minimo[]

}

model usuario_institucion {
  id_usuario       String
  usuario          usuario     @relation(fields: [id_usuario], references: [id_usuario])
  id_institucion   String
  institucion      institucion @relation(fields: [id_institucion], references: [id_institucion])
  cargo            String

  @@id([id_usuario, id_institucion])
}

model stock_minimo {
  id_institucion    String
  institucion       institucion    @relation(fields: [id_institucion], references: [id_institucion])
  grupo_sanguineo   GrupoSanguineo
  factor_rh         FactorRh
  componente        Componente
  unidades_minimas  Int

  @@id([id_institucion, grupo_sanguineo, factor_rh, componente])
}

model documento_normativa {
  id_documento_normativa   String    @id @default(uuid())
  titulo                   String
  fuente                   String
  url                      String
  texto                    String
  vigente_desde            DateTime
  vigente_hasta            DateTime?
}
