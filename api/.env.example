DATABASE_URL="postgresql://donavida:donavida@localhost:5433/donavida?schema=public"
JWT_SECRET="cambiar-esto-por-algo-largo-y-random"
PORT=3000

# Correo (en desarrollo lo recibe Mailpit del docker-compose: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="DonaVida <no-responder@donavida.local>"
# Dirección del front: el enlace de activación del correo apunta acá
APP_URL=http://localhost:5173

# Solo desarrollo: true = no manda el correo de activación y la cuenta se activa desde la pantalla del registro
VERIFICACION_SIN_CORREO=false

# Notificaciones push (TAREA-11). Generarlas una vez con: npx web-push generate-vapid-keys
# Sin estas claves la API anda igual: las alertas urgentes se mandan por correo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-responder@donavida.local
